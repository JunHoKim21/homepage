# =====================================================================
# Enterprise & Agency Starter Kit v2.0-FINAL Environment Variables
# =====================================================================
DOMAIN_NAME=localhost
SPRING_PROFILE=prod

# PostgreSQL 16
POSTGRES_DB=starter_db
POSTGRES_USER=starter_user
POSTGRES_PASSWORD=starter_secure_password_2026
POSTGRES_PORT=5432

# Security & Cache Revalidation
JWT_SECRET=replace_with_64_bytes_secure_random_key_for_production_2026_clean_license
REVALIDATE_SECRET=starter_revalidate_secret_2026

# Feature Switches (Standard vs Pro)
FEATURE_RESERVATION_MODE=BOTH
FEATURE_RESERVATION_CAPACITY=SINGLE
FEATURE_RESERVATION_DEFAULT_CAP=1
FEATURE_PAYMENT=false
FEATURE_AUDIT_LOG=false
FEATURE_EXCEL_EXPORT=true
FEATURE_ADMIN_TOTP=false
